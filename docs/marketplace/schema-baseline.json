{
  "users": {
    "required": [
      "id",
      "email",
      "first_name",
      "last_name"
    ],
    "properties": {
      "id": {
        "default": "extensions.uuid_generate_v4()",
        "description": "Note:\nThis is a Primary Key.<pk/>",
        "format": "uuid",
        "type": "string"
      },
      "email": {
        "format": "character varying",
        "maxLength": 255,
        "type": "string"
      },
      "first_name": {
        "format": "character varying",
        "maxLength": 100,
        "type": "string"
      },
      "last_name": {
        "format": "character varying",
        "maxLength": 100,
        "type": "string"
      },
      "phone": {
        "format": "character varying",
        "maxLength": 20,
        "type": "string"
      },
      "base_currency": {
        "default": "NGN",
        "format": "character varying",
        "maxLength": 3,
        "type": "string"
      },
      "status": {
        "default": "active",
        "format": "character varying",
        "maxLength": 20,
        "type": "string"
      },
      "created_at": {
        "default": "now()",
        "format": "timestamp with time zone",
        "type": "string"
      },
      "updated_at": {
        "default": "now()",
        "format": "timestamp with time zone",
        "type": "string"
      },
      "pin_hash": {
        "description": "Bcrypt hash of 6-digit PIN for mobile app authentication. Only used by mobile app, web app continues to use email/password.",
        "format": "text",
        "type": "string"
      },
      "kyc_status": {
        "description": "Bridge KYC status: pending, in_review, approved, rejected",
        "format": "text",
        "type": "string"
      },
      "kyc_rejection_reasons": {
        "description": "Array of rejection reasons from Bridge if KYC is rejected",
        "format": "jsonb"
      },
      "kyc_signed_agreement_id": {
        "description": "Bridge TOS signed agreement ID",
        "format": "text",
        "type": "string"
      },
      "bridge_usd_virtual_account_id": {
        "description": "Bridge virtual account ID for USD deposits",
        "format": "text",
        "type": "string"
      },
      "bridge_eur_virtual_account_id": {
        "description": "Bridge virtual account ID for EUR deposits",
        "format": "text",
        "type": "string"
      },
      "kyc_endorsements": {
        "description": "JSONB object storing Bridge endorsement statuses (base, sepa)",
        "format": "jsonb"
      },
      "country_code": {
        "description": "2-letter country code from Bridge KYC verification",
        "format": "text",
        "type": "string"
      },
      "residential_address": {
        "description": "JSONB object storing residential address for Bridge KYC",
        "format": "jsonb"
      },
      "kyc_external_customer_id": {
        "description": "Bridge customer ID (primary identifier for Bridge API)",
        "format": "text",
        "type": "string"
      },
      "middle_name": {
        "description": "Middle name from Bridge KYC verification",
        "format": "text",
        "type": "string"
      },
      "date_of_birth": {
        "description": "User date of birth in ISO format (YYYY-MM-DD). Used for KYC compliance and age verification.",
        "format": "date",
        "type": "string"
      },
      "address": {
        "description": "Residential address from Bridge KYC verification",
        "format": "text",
        "type": "string"
      },
      "kyc_metadata": {
        "description": "JSON metadata containing Bridge KYC data (SSN, passport, employment, etc.)",
        "format": "jsonb"
      },
      "referral_slug": {
        "description": "Opaque public slug for referral URLs; set once.",
        "format": "text",
        "type": "string"
      },
      "referred_by_user_id": {
        "description": "User who referred this account; set once at signup.\n\nNote:\nThis is a Foreign Key to `users.id`.<fk table='users' column='id'/>",
        "format": "uuid",
        "type": "string"
      },
      "referral_percent_window_ends_at": {
        "description": "When set: percent- and tier-mode referral rewards for this user as referee only apply to completed sends with completed_at <= this instant. Set once from first qualifying send min(completed_at) + duration at snapshot.",
        "format": "timestamp with time zone",
        "type": "string"
      },
      "referral_first_qualifying_completed_at": {
        "description": "Chronologically first qualifying completed send for this user as referee (non-payout reference). Set once when first computed.",
        "format": "timestamp with time zone",
        "type": "string"
      },
      "preferred_language": {
        "format": "text",
        "type": "string"
      },
      "avatar_url": {
        "format": "text",
        "type": "string"
      }
    },
    "type": "object"
  },
  "transactions": {
    "required": [
      "id",
      "transaction_id",
      "user_id",
      "send_amount",
      "send_currency",
      "receive_amount",
      "receive_currency",
      "exchange_rate",
      "total_amount",
      "fulfillment_type",
      "logistics_fee_amount",
      "transaction_source",
      "hub_fee_amount",
      "payment_provider"
    ],
    "properties": {
      "id": {
        "default": "extensions.uuid_generate_v4()",
        "description": "Note:\nThis is a Primary Key.<pk/>",
        "format": "uuid",
        "type": "string"
      },
      "transaction_id": {
        "format": "character varying",
        "maxLength": 50,
        "type": "string"
      },
      "user_id": {
        "description": "Note:\nThis is a Foreign Key to `users.id`.<fk table='users' column='id'/>",
        "format": "uuid",
        "type": "string"
      },
      "recipient_id": {
        "description": "Bank recipient for bank_transfer; NULL for cash_hand when no bank recipient is used.\n\nNote:\nThis is a Foreign Key to `recipients.id`.<fk table='recipients' column='id'/>",
        "format": "uuid",
        "type": "string"
      },
      "send_amount": {
        "format": "numeric",
        "type": "number"
      },
      "send_currency": {
        "description": "Note:\nThis is a Foreign Key to `currencies.code`.<fk table='currencies' column='code'/>",
        "format": "character varying",
        "maxLength": 3,
        "type": "string"
      },
      "receive_amount": {
        "format": "numeric",
        "type": "number"
      },
      "receive_currency": {
        "description": "Note:\nThis is a Foreign Key to `currencies.code`.<fk table='currencies' column='code'/>",
        "format": "character varying",
        "maxLength": 3,
        "type": "string"
      },
      "exchange_rate": {
        "format": "numeric",
        "type": "number"
      },
      "fee_amount": {
        "default": 0,
        "format": "numeric",
        "type": "number"
      },
      "fee_type": {
        "default": "free",
        "format": "character varying",
        "maxLength": 20,
        "type": "string"
      },
      "total_amount": {
        "format": "numeric",
        "type": "number"
      },
      "status": {
        "default": "pending",
        "format": "character varying",
        "maxLength": 20,
        "type": "string"
      },
      "receipt_url": {
        "description": "URL to the uploaded payment receipt in Supabase Storage",
        "format": "text",
        "type": "string"
      },
      "receipt_filename": {
        "description": "Original filename of the uploaded receipt",
        "format": "character varying",
        "maxLength": 255,
        "type": "string"
      },
      "created_at": {
        "default": "now()",
        "format": "timestamp with time zone",
        "type": "string"
      },
      "updated_at": {
        "default": "now()",
        "format": "timestamp with time zone",
        "type": "string"
      },
      "reference": {
        "format": "text",
        "type": "string"
      },
      "completed_at": {
        "description": "When the transfer reached completed status; may be null if only updated_at is used.",
        "format": "timestamp with time zone",
        "type": "string"
      },
      "fulfillment_type": {
        "default": "bank_transfer",
        "format": "text",
        "type": "string"
      },
      "logistics_fee_amount": {
        "default": 0,
        "description": "Resolved logistics charge in send_currency included in total_amount (0 for bank_transfer).",
        "format": "numeric",
        "type": "number"
      },
      "logistics_fee_type_snapshot": {
        "format": "text",
        "type": "string"
      },
      "delivery_address_line": {
        "format": "text",
        "type": "string"
      },
      "delivery_phone": {
        "format": "text",
        "type": "string"
      },
      "delivery_address_id": {
        "description": "Note:\nThis is a Foreign Key to `delivery_addresses.id`.<fk table='delivery_addresses' column='id'/>",
        "format": "uuid",
        "type": "string"
      },
      "transaction_source": {
        "default": "send",
        "description": "send | hub",
        "format": "text",
        "type": "string"
      },
      "hub_product_id": {
        "description": "Note:\nThis is a Foreign Key to `hub_products.id`.<fk table='hub_products' column='id'/>",
        "format": "uuid",
        "type": "string"
      },
      "hub_snapshot": {
        "description": "Immutable Hub order snapshot for UI/support",
        "format": "jsonb"
      },
      "hub_fee_amount": {
        "default": 0,
        "format": "numeric",
        "type": "number"
      },
      "payment_provider": {
        "default": "manual",
        "format": "text",
        "type": "string"
      },
      "gateway_payment_id": {
        "format": "text",
        "type": "string"
      },
      "gateway_status": {
        "format": "text",
        "type": "string"
      },
      "gateway_confirmation_url": {
        "format": "text",
        "type": "string"
      },
      "send_quote_id": {
        "description": "Note:\nThis is a Foreign Key to `send_quotes.id`.<fk table='send_quotes' column='id'/>",
        "format": "uuid",
        "type": "string"
      },
      "payment_processing_fee": {
        "format": "numeric",
        "type": "number"
      },
      "bitbanker_conversion_snapshot": {
        "format": "jsonb"
      },
      "settlement_metadata": {
        "format": "jsonb"
      }
    },
    "type": "object"
  },
