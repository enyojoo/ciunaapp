  "radius": {
    "control": 12,
    "card": 16,
    "sheet": 24,
    "pill": 999,
    "hero": 20
  },
  "space": {
    "tap": 48,
    "page": 20,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32,
    "gutter": 16
  },
  "motion": {
    "fast": 150,
    "sheet": 180,
    "normal": 220
  },
  "type": {
    "largeTitle": 32,
    "display": 44,
    "title": 24,
    "headline": 20,
    "listTitle": 16,
    "body": 16,
    "label": 15,
