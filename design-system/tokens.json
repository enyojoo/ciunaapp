{
  "name": "Ciuna",
  "version": 1,
  "description": "Single source of truth for every Ciuna surface: customer app (Expo + web), Ciuna Seller, Office, documents. Run `npm run design:sync` after editing; `npm run design:check` fails on drift or on any text pair below AA.",
  "color": {
    "brand-primary": {
      "value": "#F97316",
      "usage": "The logo orange. Logo, illustrations, large decorative areas, brand moments. NOT for filled controls or small text (white on it is 2.8:1)."
    },
    "primary": {
      "value": "#CD4B0E",
      "usage": "Fill for buttons, active tabs, selected chips, badges with white labels and focus rings. White label on it is 4.56:1. A deeper cousin of the logo orange so white text passes AA."
    },
    "primary-foreground": {
      "value": "#FFFFFF",
      "usage": "Label colour on any `primary` fill. 4.56:1."
    },
    "primary-hover": {
      "value": "#B8420B",
      "usage": "Hover and pressed fill. White label is 5.7:1."
    },
    "primary-text": {
      "value": "#C2410C",
      "usage": "Orange used as TEXT or a link on paper/white (5.2:1). Small orange text never uses brand-primary."
    },
    "primary-tint": {
      "value": "#FFF3E8",
      "usage": "Selected rows, soft callouts, icon wells."
    },
    "primary-border": {
      "value": "#FDBA74",
      "usage": "Selected outline on tint."
    },
    "selected": {
      "value": "#111827",
      "usage": "Fill for the selected chip, segment or filter. Orange stays for the one primary action per screen."
    },
    "on-selected": {
      "value": "#FFFFFF",
      "usage": "Label on a `selected` fill. 17.7:1."
    },
    "ink": {
      "value": "#111827",
      "usage": "Primary text and dark surfaces."
    },
    "paper": {
      "value": "#FAFAF8",
      "usage": "Canvas behind plates on native and Seller."
    },
    "surface": {
      "value": "#FFFFFF",
      "usage": "Plates, sheets, cards, inputs."
    },
    "muted": {
      "value": "#52596B",
      "usage": "Secondary text on paper and surface (7.0:1 / 6.6:1). Replaces #6B7280 which is only 4.5:1 on paper."
    },
    "subtle": {
      "value": "#8A8F9C",
      "usage": "Icons, chevrons, placeholders only. Never body text."
    },
    "hairline": {
      "value": "#E8E4DC",
      "usage": "Decorative dividers and card edges."
    },
    "input-edge": {
      "value": "#8A8578",
      "usage": "Form-control edge, 3.2:1 on surface."
    },
    "success": {
      "value": "#047857",
      "usage": "Completed, Paid, Live, Verified. Solid fill; white label 5.5:1."
    },
    "success-surface": {
      "value": "#ECFDF5",
      "usage": "Success badge/banner ground."
    },
    "success-text": {
      "value": "#065F46",
      "usage": "Success text and icons."
    },
    "warning": {
      "value": "#B45309",
      "usage": "Pending, Preparing, In review. Solid fill; white label 5.0:1."
    },
    "warning-surface": {
      "value": "#FFFBEB",
      "usage": "Warning ground."
    },
    "warning-text": {
      "value": "#92400E",
      "usage": "Warning text and icons."
    },
    "destructive": {
      "value": "#B91C1C",
      "usage": "Failed, Rejected, Overdue, destructive actions. White label 6.5:1."
    },
    "destructive-surface": {
      "value": "#FEF2F2",
      "usage": "Destructive ground."
    },
    "destructive-text": {
      "value": "#991B1B",
      "usage": "Destructive text and icons."
    },
    "neutral-surface": {
      "value": "#F3F4F6",
      "usage": "Draft, Paused, Cancelled badge ground."
    },
    "neutral-text": {
      "value": "#374151",
      "usage": "Neutral badge text."
    },
    "fill": {
      "value": "#F1EFEA",
      "usage": "Image placeholders, skeleton tracks and pressed-row backgrounds on paper or surface. Warm neutral; never for text."
    },
    "refer": {
      "value": "#0F766E",
      "usage": "Refer and earn accent (teal). Never a status."
    },
    "refer-surface": {
      "value": "#F0FDFA",
      "usage": "Refer pill ground."
    },
    "scrim": {
      "value": "#111827",
      "usage": "Dialog/sheet overlay at 55% opacity."
    },
    "hero-orange": {
      "value": "#EA580C",
      "usage": "Start of the customer app hero gradient (Home banner, service-line header bar). Large decorative area only; white text on it is 3.6:1, so only titles of 22px or more bold may sit on it, never small text."
    },
    "hero-orange-mid": {
      "value": "#F97316",
      "usage": "Middle stop of the hero gradient."
    },
    "hero-amber": {
      "value": "#FBBF24",
      "usage": "End stop of the hero gradient. No white text over this end of the gradient in Improved frames."
    },
    "hero-body": {
      "value": "#FFF7ED",
      "usage": "Body text colour the Current app puts on the hero gradient, and the ground of icon wells in More rows. Improved frames do not use it for small text on the gradient."
    },
    "card-edge": {
      "value": "#E5E7EB",
      "usage": "Cool grey 1px edge the native product card uses today (Current frames). Improved frames use hairline."
    },
    "star-empty": {
      "value": "#D1D5DB",
      "usage": "Empty rating star outline on white (decorative; the rating is also written as a number)."
    },
    "refer-border": {
      "value": "#99F6E4",
      "usage": "Refer pill edge."
    },
    "refer-text": {
      "value": "#134E4A",
      "usage": "Refer pill label."
    },
    "refer-icon": {
      "value": "#115E59",
      "usage": "Refer pill icon."
    }
  },
  "pairs": [
