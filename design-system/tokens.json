{
  "name": "Ciuna",
  "version": 1,
  "description": "Single source of truth for every Ciuna surface: customer app (Expo + web), Ciuna Seller, Office, documents. Run `npm run design:sync` after editing; `npm run design:check` fails on drift or on any text pair below AA.",
  "color": {
    "brand-primary": {
      "value": "#F97316",
      "usage": "The logo orange. Logo, illustrations, large decorative areas, brand moments. NOT for filled controls or small text (white on it is 2.8:1)."
    },
    "primary": {
      "value": "#CD4B0E",
      "usage": "Fill for buttons, active tabs, selected chips, badges with white labels and focus rings. White label on it is 4.56:1. A deeper cousin of the logo orange so white text passes AA."
    },
    "primary-foreground": {
      "value": "#FFFFFF",
      "usage": "Label colour on any `primary` fill. 4.56:1."
    },
    "primary-hover": {
      "value": "#B8420B",
      "usage": "Hover and pressed fill. White label is 5.7:1."
    },
    "primary-text": {
      "value": "#C2410C",
      "usage": "Orange used as TEXT or a link on paper/white (5.2:1). Small orange text never uses brand-primary."
    },
    "primary-tint": {
      "value": "#FFF3E8",
      "usage": "Selected rows, soft callouts, icon wells."
    },
    "primary-border": {
      "value": "#FDBA74",
      "usage": "Selected outline on tint."
    },
    "ink": {
      "value": "#111827",
      "usage": "Primary text and dark surfaces."
    },
    "paper": {
      "value": "#FAFAF8",
      "usage": "Canvas behind plates on native and Seller."
    },
    "surface": {
      "value": "#FFFFFF",
      "usage": "Plates, sheets, cards, inputs."
    },
    "muted": {
      "value": "#52596B",
      "usage": "Secondary text on paper and surface (7.0:1 / 6.6:1). Replaces #6B7280 which is only 4.5:1 on paper."
    },
    "subtle": {
      "value": "#8A8F9C",
      "usage": "Icons, chevrons, placeholders only. Never body text."
    },
    "hairline": {
      "value": "#E8E4DC",
      "usage": "Decorative dividers and card edges."
    },
    "input-edge": {
      "value": "#8A8578",
      "usage": "Form-control edge, 3.2:1 on surface."
    },
    "success": {
      "value": "#047857",
      "usage": "Completed, Paid, Live, Verified. Solid fill; white label 5.5:1."
    },
    "success-surface": {
      "value": "#ECFDF5",
      "usage": "Success badge/banner ground."
    },
    "success-text": {
      "value": "#065F46",
      "usage": "Success text and icons."
    },
    "warning": {
      "value": "#B45309",
      "usage": "Pending, Preparing, In review. Solid fill; white label 5.0:1."
    },
    "warning-surface": {
      "value": "#FFFBEB",
      "usage": "Warning ground."
    },
    "warning-text": {
      "value": "#92400E",
      "usage": "Warning text and icons."
    },
    "destructive": {
      "value": "#B91C1C",
      "usage": "Failed, Rejected, Overdue, destructive actions. White label 6.5:1."
    },
    "destructive-surface": {
      "value": "#FEF2F2",
      "usage": "Destructive ground."
    },
    "destructive-text": {
      "value": "#991B1B",
      "usage": "Destructive text and icons."
    },
    "neutral-surface": {
      "value": "#F3F4F6",
      "usage": "Draft, Paused, Cancelled badge ground."
    },
    "neutral-text": {
      "value": "#374151",
      "usage": "Neutral badge text."
    },
    "refer": {
      "value": "#0F766E",
      "usage": "Refer and earn accent (teal). Never a status."
    },
    "refer-surface": {
      "value": "#F0FDFA",
      "usage": "Refer pill ground."
    },
    "scrim": {
      "value": "#111827",
      "usage": "Dialog/sheet overlay at 55% opacity."
    }
  },
  "pairs": [
    {
      "fg": "primary-foreground",
      "bg": "primary",
      "min": 4.5,
      "label": "White button label on primary"
    },
    {
      "fg": "primary-foreground",
      "bg": "primary-hover",
      "min": 4.5,
      "label": "White button label on hover primary"
    },
    {
      "fg": "primary",
      "bg": "surface",
      "min": 4.5,
      "label": "Focus ring / primary border on white"
    },
    {
      "fg": "brand-primary",
      "bg": "surface",
      "min": 2.5,
      "label": "Logo orange: icons and large shapes only (documented below text AA)"
    },
    {
      "fg": "primary-text",
      "bg": "surface",
      "min": 4.5,
      "label": "Orange link on white"
    },
    {
      "fg": "primary-text",
      "bg": "paper",
      "min": 4.5,
      "label": "Orange link on paper"
    },
    {
      "fg": "primary-text",
      "bg": "primary-tint",
      "min": 4.5,
      "label": "Orange text on tint"
    },
    {
      "fg": "ink",
      "bg": "paper",
      "min": 7,
      "label": "Body on paper"
    },
    {
      "fg": "ink",
      "bg": "surface",
      "min": 7,
      "label": "Body on white"
    },
    {
      "fg": "muted",
      "bg": "paper",
      "min": 4.5,
      "label": "Secondary on paper"
    },
    {
      "fg": "muted",
      "bg": "surface",
      "min": 4.5,
      "label": "Secondary on white"
    },
    {
      "fg": "#FFFFFF",
      "bg": "success",
      "min": 4.5,
      "label": "White on success fill"
    },
    {
      "fg": "#FFFFFF",
      "bg": "warning",
      "min": 4.5,
      "label": "White on warning fill"
    },
    {
      "fg": "#FFFFFF",
      "bg": "destructive",
      "min": 4.5,
      "label": "White on destructive fill"
    },
    {
      "fg": "success-text",
      "bg": "success-surface",
      "min": 4.5,
      "label": "Success badge"
    },
    {
      "fg": "warning-text",
      "bg": "warning-surface",
      "min": 4.5,
      "label": "Warning badge"
    },
    {
      "fg": "destructive-text",
      "bg": "destructive-surface",
      "min": 4.5,
      "label": "Destructive badge"
    },
    {
      "fg": "neutral-text",
      "bg": "neutral-surface",
      "min": 4.5,
      "label": "Neutral badge"
    },
    {
      "fg": "refer",
      "bg": "refer-surface",
      "min": 4.5,
      "label": "Refer pill"
    },
    {
      "fg": "input-edge",
      "bg": "surface",
      "min": 3,
      "label": "Input edge (non-text 3:1)"
    }
  ],
  "radius": {
    "control": 12,
    "card": 16,
    "sheet": 24,
    "pill": 999
  },
  "space": {
    "tap": 48,
    "page": 20
  },
  "motion": {
    "fast": 150,
    "sheet": 180,
    "normal": 220
  },
  "type": {
    "title": 24,
    "body": 16,
    "label": 15,
    "meta": 13
  },
  "shadow": {
    "xs": "0 1px 2px rgba(17,24,39,.06)",
    "sm": "0 2px 8px rgba(17,24,39,.08)",
    "md": "0 8px 24px rgba(17,24,39,.10)",
    "lg": "0 18px 48px rgba(17,24,39,.16)",
    "card-face": "0 4px 12px rgba(17,24,39,.20)"
  },
  "font": {
    "web": "Geist, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
    "native": "-apple-system, 'SF Pro Text', Roboto, system-ui, sans-serif",
    "mono": "ui-monospace, 'SF Mono', Menlo, monospace"
  },
  "breakpoint": {
    "sm": 640,
    "md": 768,
    "lg": 1024,
    "xl": 1280
  },
  "frame": {
    "phone": {
      "width": 390,
      "height": 844
    },
    "tablet": {
      "width": 820,
      "height": 1180
    },
    "desktop": {
      "width": 1280,
      "height": 800
    }
  }
}
