# Shared public URLs (all apps)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_OFFICE_URL=http://localhost:3001

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bitbanker send verification gate (unset = off in dev, on in production)
# CIUNA_SEND_VERIFICATION_GATE=on
# EXPO_PUBLIC_CIUNA_SEND_VERIFICATION_GATE=on
# NEXT_PUBLIC_CIUNA_SEND_VERIFICATION_GATE=on

# Marketplace: blank = Food/Mart/Experts may check out (Office Hub service line Enabled is the switch).
# Optional allow-list e.g. food or food,mart for API-level restrict only.
MARKETPLACE_CHECKOUT_LINES=
# API worker Bearer secret (also store as marketplace_worker_secret in Supabase Vault).
MARKETPLACE_WORKER_SECRET=
# Base64-encoded 32-byte AES key. Generate: openssl rand -base64 32
# Keep stable while any native payment may still require replay.
MARKETPLACE_TOKEN_KEY=
