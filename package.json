{
  "name": "ciuna",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "packages/*",
    "web",
    "office",
    "api",
    "mobile",
    "seller"
  ],
  "scripts": {
    "design:sync": "node design-system/scripts/sync-tokens.mjs",
    "design:check": "node design-system/scripts/sync-tokens.mjs --check",
    "design:cards": "node design-system/scripts/check-cards.mjs",
    "locales:check": "node scripts/check-locales.mjs",
    "dev": "turbo run dev --filter=api --filter=web",
    "dev:web": "turbo run dev --filter=web",
    "dev:api": "turbo run dev --filter=api",
    "dev:all": "turbo run dev --filter=api --filter=web --filter=office",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=web",
    "build:api": "turbo run build --filter=api",
    "build:shared": "turbo run build --filter=@ciuna/shared",
    "lint": "turbo run lint",
    "start:web": "turbo run start --filter=web",
    "start:api": "turbo run start --filter=api",
    "dev:office": "turbo run dev --filter=office",
    "build:office": "turbo run build --filter=office",
    "start:office": "turbo run start --filter=office",
    "dev:mobile": "npm run start -w mobile",
    "dev:mobile:web": "npm run web -w mobile",
    "export:mobile:web": "npm run export:web -w mobile",
    "sync:rates:debug": "npm run sync:debug -w @ciuna/rate-sync --",
    "design:cards-build": "node design-system/scripts/build-cards.mjs",
    "design:audit": "node design-system/scripts/audit-cards.mjs",
    "test:seller": "playwright test --project=seller-375 --project=seller-768 --project=seller-1280"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "turbo": "^2.8.12"
  },
  "dependencies": {
    "next": "^16.1.6"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "unrs-resolver": true
  }
}
