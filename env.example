# Copy into web/.env, office/.env, api/.env as needed.
# Never put api-only secrets on web, office, or mobile.

# --- All clients ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_OFFICE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- mobile (Expo, mobile/.env) ---
EXPO_PUBLIC_API_URL=http://localhost:3002
EXPO_PUBLIC_APP_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- api only (api/.env) ---
SUPABASE_SERVICE_ROLE_KEY=
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=noreply@ciuna.com
SES_FROM_NAME=Ciuna
SES_REPLY_TO=support@ciuna.com
CRON_SECRET=
WEBHOOK_SECRET=
JWT_SECRET=
ADMIN_TRANSACTION_NOTIFICATION_EMAIL=enyo@ciuna.com
INTERNAL_API_SECRET=
