# Copy into web/.env, office/.env, api/.env as needed.
# Never put api-only secrets on web, office, or mobile.

# --- All clients ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_OFFICE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- mobile (Expo, mobile/.env) ---
# Expo Go on device: localhost is auto-rewritten to LAN IP (mobile/app.config.js).
# Simulator: EXPO_PUBLIC_DEV_USE_LOCALHOST=1
EXPO_PUBLIC_API_URL=http://localhost:3002
EXPO_PUBLIC_APP_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- api only (api/.env) ---
SUPABASE_SERVICE_ROLE_KEY=
SES_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=hello@ciuna.com
SES_FROM_NAME=Ciuna
SES_REPLY_TO=support@ciuna.com
CRON_SECRET=
WEBHOOK_SECRET=
JWT_SECRET=
ADMIN_TRANSACTION_NOTIFICATION_EMAIL=admin@ciuna.com
INTERNAL_API_SECRET=
# Optional extra browser origins, comma-separated (e.g. https://ciunaapp.vercel.app)
CORS_ALLOWED_ORIGINS=

# --- YooKassa (RUB online payments for Hub/Experts checkout; api only) ---
# https://yookassa.ru/developers/using-api/using-sdks — leave blank until a shop is set up;
# checkout falls back to bank-transfer-only when unset.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Where the Checkout.js widget / redirect returns to after payment (e.g. https://app.ciuna.com/pay/return)
YOOKASSA_RETURN_URL=

# --- Bitbanker (RUB SBP send; api only) ---
BITBANKER_ENVIRONMENT=sandbox
# Sandbox (verified): https://ext-api.dev.bitbanker.ru — do not append /latest
# Production: https://api.aws.bitbanker.org/latest
BITBANKER_API_BASE_URL=https://ext-api.dev.bitbanker.ru
BITBANKER_API_KEY=
BITBANKER_API_SECRET=
# api/scripts/bitbanker-connectivity.ts — optional signed GET + invoice smoke
BITBANKER_TEST_CLIENT_ID=
# BITBANKER_SMOKE_SEND_INVOICE=1
