{
  "expo": {
    "name": "Ciuna",
    "slug": "ciuna",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ciuna",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ciuna.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock Ciuna with Face ID after your PIN.",
        "NSPhotoLibraryUsageDescription": "Upload identity and address documents."
      }
    },
    "android": {
      "package": "com.ciuna.app",
      "adaptiveIcon": {
        "backgroundColor": "#F97316",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "app.ciuna.com", "pathPrefix": "/" },
            { "scheme": "https", "host": "m.ciuna.com", "pathPrefix": "/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-web-browser",
      "expo-local-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Upload identity and address documents."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F97316"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://m.ciuna.com"
      },
      "eas": {
        "projectId": ""
      }
    }
  }
}
