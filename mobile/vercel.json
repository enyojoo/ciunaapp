{
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|twitterbot|slackbot|facebookexternalhit|imessage|linkedinbot|telegrambot|discordbot).*"
        }
      ],
      "destination": "https://api.ciuna.com/api/share/:slug"
    }
  ]
}
