{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd .. && npm ci --ignore-scripts --workspace=mobile --workspace=@ciuna/shared --include-workspace-root",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/_expo/static/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|twitterbot|slackbot|facebookexternalhit|imessage|linkedinbot|telegrambot|discordbot).*"
        }
      ],
      "destination": "https://api.ciuna.com/api/share/:slug"
    },
    {
      "source": "/((?!_expo/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
