# Copy to mobile/.env — never put service role or AWS SES keys here.
# Physical device + Expo Go: keep localhost here; app.config.js maps it to your LAN IP.
# iOS Simulator or Expo web (browser): EXPO_PUBLIC_DEV_USE_LOCALHOST=1
# Or: npm run web -w mobile (sets localhost automatically)
EXPO_PUBLIC_API_URL=http://localhost:3002
EXPO_PUBLIC_APP_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
